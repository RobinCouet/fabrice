{% extends 'base.html.twig' %}

{% block title %}Player index
{% endblock %}

{% block body %}
	<h1>Player index</h1>

	<table class="table">
		<thead>
			<tr>
				<th>Id</th>
				<th>Name</th>
				<th>Age</th>
				<th>Birthdate</th>
				<th>Team</th>
				<th>Ville</th>
				<th>actions</th>
			</tr>
		</thead>
		<tbody>
			{% for player in players %}
				<tr>
					<td>{{ player.id }}</td>
					<td>{{ player.name }}</td>
					<td>{{ player.age }}</td>
					<td>{{ player.birthdate ? player.birthdate|date('Y-m-d') : '' }}</td>
					<td>{{ player.team.name }}</td>
					<td>{{ player.team.city }}</td>
					<td>
						<a href="{{ path('app_player_show', {'id': player.id}) }}">show</a>
						<a href="{{ path('app_player_edit', {'id': player.id}) }}">edit</a>
					</td>
				</tr>
			{% else %}
				<tr>
					<td colspan="5">no records found</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>

	<a href="{{ path('app_player_new') }}">Create new</a>
{% endblock %}
