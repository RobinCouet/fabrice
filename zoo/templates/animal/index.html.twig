{% extends 'base.html.twig' %}

{% block title %}Hello AnimalController!
{% endblock %}

{% block body %}

	<ul>
		{% for animal in animals %}
			<li>
				<a href="{{ path('app_animal_show', {'id': animal.id}) }}">
					{{ animal.name }}
					-
					{{ animal.type }}
				</a>
				<a href="{{ path('app_animal_edit', {'id': animal.id}) }}">Modifier</a>
				<a href="{{ path('app_animal_delete', {'id': animal.id}) }}">Supprimer</a>
			</li>
		{% endfor %}
	</ul>

{% endblock %}
